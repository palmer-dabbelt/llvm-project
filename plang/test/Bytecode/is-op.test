# Test identity operators: is, is not
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/test.py
# RUN: %python -m compileall -b %t/test.py
# RUN: %plang --run %t/test.pyc | FileCheck %s
# CHECK: 1
# CHECK: 0
# CHECK: 0
# CHECK: 1
# CHECK: Result: 0

# Test 'is' with same value
x = 5
y = 5
print(x is y)

# Test 'is' with different values
z = 10
print(x is z)

# Test 'is not' with same value
print(x is not y)

# Test 'is not' with different values
print(x is not z)
