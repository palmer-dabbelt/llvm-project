# Test that a constant-folded expression returns the correct value
# The expression 1+2+3 = 6, which is also used as the exit code
#
# RUN: %python -c "import marshal, struct; code = compile('1 + 2 + 3', 'test', 'eval'); f = open('%t.pyc', 'wb'); f.write(b'a\r\r\n' + struct.pack('<I', 0) * 3 + marshal.dumps(code)); f.close()"
# RUN: %plang --run %t.pyc 2>&1 | FileCheck %s || test $? -eq 6
# CHECK: Result: 6
