# Test DELETE_FAST opcode (del x in function scope)
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: cp %s %t/test.py
# RUN: %python -m compileall -b %t/test.py
# RUN: %plang --run %t/test.pyc | FileCheck %s
# CHECK: 42
# CHECK: 0
# CHECK: Result: 0

def test():
    x = 42
    print(x)
    del x  # DELETE_FAST opcode
    return 0

result = test()
print(result)
